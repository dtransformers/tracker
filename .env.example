# ──────────────────────────────────────────────
# Application
# ──────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8080

# Accepted values: development | production | testing
RUN_MODE=development

# Session expiration in seconds (default: 7200 = 2h)
SESSION_EXPIRATION=7200

# Visitor expiration in seconds (default: 31536000 = 1 year)
VISITOR_EXPIRATION=31536000

# Comma-separated list of allowed CORS origins (optional)
ALLOWED_ORIGINS=http://localhost:3000

# Comma-separated list of trusted reverse-proxy IPs (optional)
APP_TRUSTED_PROXIES=

# ──────────────────────────────────────────────
# Database (PostgreSQL)
# ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=secret
DB_DATABASE=tracker

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DATABASE=0

# Optional Redis credentials
REDIS_USERNAME=
REDIS_PASSWORD=

# ──────────────────────────────────────────────
# TLS
# ──────────────────────────────────────────────
TLS_ENABLED=false
TLS_CERT_FILE=
TLS_KEY_FILE=

# ──────────────────────────────────────────────
# Auth
# ──────────────────────────────────────────────
ROOT_USERNAME=admin
ROOT_PASSWORD=changeme
